# Site configuration
# Copy this file to .env.local and fill in real values.
SITE_URL=https://csdigitaltech.com
NEXT_PUBLIC_SITE_URL=https://csdigitaltech.com

# ---------------------------------------------------------------------------
# $10 Website Audit (Stripe Checkout) — /website-audit
# ---------------------------------------------------------------------------
# Stripe secret key (server-only). Use sk_test_... locally.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint https://<your-domain>/api/stripe/webhook
# (Stripe Dashboard -> Developers -> Webhooks; subscribe to checkout.session.completed
# and checkout.session.async_payment_succeeded). Locally: `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints a whsec_... value.
STRIPE_WEBHOOK_SECRET=
# Optional. Paid audit orders are POSTed here as JSON (n8n / Zapier / GHL) so the team
# can fulfil them. If unset, orders are only visible in the Stripe dashboard and logs.
AUDIT_ORDER_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Form webhooks (REQUIRED — forms return 503 if unset). Server-only; never prefix
# these with NEXT_PUBLIC_. Treat the URLs as secrets.
# ---------------------------------------------------------------------------
CONTACT_FORM_WEBHOOK_URL=
CAREERS_FORM_WEBHOOK_URL=
# /marketing forms (quote requests and contact). Posted from the server via
# /api/marketing/lead. Falls back to the old NEXT_PUBLIC_* names if you already set those.
MARKETING_LEAD_WEBHOOK_URL=
MARKETING_CONTACT_WEBHOOK_URL=
