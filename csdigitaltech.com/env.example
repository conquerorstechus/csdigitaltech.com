# Site configuration
# Copy this file to .env.local and fill in real values.
SITE_URL=https://csdigitaltech.com
NEXT_PUBLIC_SITE_URL=https://csdigitaltech.com

# ---------------------------------------------------------------------------
# Opinly (REQUIRED on Vercel Production — then redeploy)
# Values: Opinly → Settings → Developers
# Never prefix OPINLY_API_KEY with NEXT_PUBLIC_ (server-only secret).
# ---------------------------------------------------------------------------
OPINLY_API_KEY=

# CDN namespace (exactly 21 characters). Also set in next.config.mjs as
# cdnNamespace; keep both in sync if you rotate the namespace.
OPINLY_CDN_NAMESPACE=

# Optional. Default is https://sdk.opinly.ai — do NOT use https://api.opinly.ai
# OPINLY_API_URL=https://sdk.opinly.ai

# Blog path / branding (also injected by withOpinlyConfig in next.config.mjs)
OPINLY_BLOG_PREFIX=/blog
OPINLY_IMAGES_PREFIX=/images
OPINLY_SITE_NAME=Cornerstone Digital Technologies
OPINLY_CATEGORY_PREFIX=category
OPINLY_AUTHOR_PREFIX=authors
OPINLY_TAG_PREFIX=tag
