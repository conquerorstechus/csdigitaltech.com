# Site configuration
# Copy this file to .env.local and fill in real values.
SITE_URL=https://csdigitaltech.com
NEXT_PUBLIC_SITE_URL=https://csdigitaltech.com

# Opinly configuration
# API key from Opinly → Settings → Developers
OPINLY_API_KEY=

# CDN namespace from Opinly → Settings → Developers
OPINLY_CDN_NAMESPACE=

# Opinly API
OPINLY_API_URL=https://api.opinly.ai

# Blog configuration
OPINLY_BLOG_PREFIX=/blog
OPINLY_IMAGES_PREFIX=/images
OPINLY_SITE_NAME=Cornerstone Digital Technologies
OPINLY_CATEGORY_PREFIX=category
OPINLY_AUTHOR_PREFIX=authors
OPINLY_TAG_PREFIX=tag